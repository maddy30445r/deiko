# secrets
.env

# node
node_modules/
dist/
*.tsbuildinfo

# swift
.build/
.swiftpm/
*.o

# The assembled app bundle. Rebuilt by `make bundle` from sources that ARE
# tracked, so committing it only churns a 1MB binary on every build — and a
# stale committed copy is worse than none, since it is what `open build/Fovea.app`
# would launch.
build/

# Captured content — never commit crops, audio, transcripts or probe logs.
# These carry whatever was on screen: DB ids, tokens, customer data, scrollback.
#
# Matched by PATTERN, not just by directory: a probe log written to the wrong
# folder is still a leak, and that is exactly how ax-poked.jsonl reached a
# commit. Anything ignored here is ignored wherever it lands.
sessions/
*.jsonl
crops/
*.wav
# Crops are screenshots of whatever was on screen, and both crop destinations
# are user-settable (`capture --out`, `ax-probe --crop-dir`) — so the pattern,
# not just the folders. No source imagery exists in this repo to collide with.
*.png

# macOS
.DS_Store
