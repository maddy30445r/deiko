# Copy to .env and fill in. .env is gitignored.

# Sarvam — ASR (Saaras / Saarika). Used from T0.2 onward for word-level timestamps.
SARVAM_API_KEY=

# Anthropic — plan generation (M2). Not needed for Phase 0.
ANTHROPIC_API_KEY=

# Groq — the review window's three-line summary of a session. Optional: without
# it the window simply shows no summary. Only the NARRATION is ever sent here —
# never referent text, OCR, window titles, or crops. See scripts/summarize.mjs.
GROQ_API_KEY=

# OpenAI — Whisper fallback transcription. Not needed for Phase 0.
OPENAI_API_KEY=
