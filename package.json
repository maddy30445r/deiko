{
  "name": "fovea",
  "version": "0.0.0",
  "private": true,
  "description": "Point-and-speak task capture for macOS. Eyes for Claude Code.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test scripts/test/*.test.mjs services/relay/test/*.test.mjs",
    "hello": "node scripts/hello.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
